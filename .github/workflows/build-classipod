      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'
          cache: gradle

      - name: Add Classipod interface and hidden downloads
        run: python3 apply_mod.py Classipod.kt

      - name: Restore signing key
        id: keycache
        uses: actions/cache@v4
        with:
          path: lw-signing.p12
          key: lastwave-ipod-signing-key-v1

      - name: Create signing key (first run only)
        if: steps.keycache.outputs.cache-hit != 'true'
        run: |
          keytool -genkeypair -keystore lw-signing.p12 -storetype PKCS12 \
            -storepass lastwaveipod -keypass lastwaveipod -alias release_key \
            -keyalg RSA -keysize 2048 -validity 10000 -dname "CN=LastWave iPod build"

      - name: Prepare signing settings
        run: |
